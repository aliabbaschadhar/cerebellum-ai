// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector"), prisma_postgres]
}

model Link {
  id          String   @id @default(cuid())
  url         String
  platform    String   // youtube | twitter | github | reddit | instagram | article | generic
  title       String?
  description String?
  image       String?
  favicon     String?
  siteName    String?
  // Platform-specific extras stored as JSON
  extras      Json?
  // Additional context provided by the user to help AI search
  aiContext   String?
  createdAt   DateTime @default(now())
  embedding   LinkEmbedding?
}

model LinkEmbedding {
  id        String   @id @default(cuid())
  linkId    String   @unique
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  vector    Unsupported("vector(384)")
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id           String      @id @default(cuid())
  sessionId    String
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         ChatRole
  content      String
  referenceIds String[]
  createdAt    DateTime    @default(now())
}


