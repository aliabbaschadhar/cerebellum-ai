{
  "manifest_version": 3,
  "name": "Cerebellum AI Link Saver",
  "version": "1.0",
  "description": "Save links to Cerebellum from any platform.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "css": ["toast.css"],
      "js": ["common-injector.js", "instagram-injector.js"]
    },
    {
      "matches": ["*://*.reddit.com/*"],
      "css": ["toast.css"],
      "js": ["common-injector.js", "reddit-injector.js"]
    },
    {
      "matches": ["*://twitter.com/*", "*://x.com/*"],
      "css": ["toast.css"],
      "js": ["common-injector.js", "x-injector.js"]
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["toast.css"],
      "js": ["common-injector.js", "youtube-injector.js"]
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "css": ["toast.css"],
      "js": ["common-injector.js", "tiktok-injector.js"]
    },
    {
      "matches": ["*://*.linkedin.com/*"],
      "css": ["toast.css"],
      "js": ["common-injector.js", "linkedin-injector.js"]
    },
    {
      "matches": ["*://github.com/*"],
      "css": ["toast.css"],
      "js": ["common-injector.js", "github-injector.js"]
    },
    {
      "matches": ["*://*.hashnode.com/*", "*://hashnode.com/*", "*://*.hashnode.dev/*"],
      "css": ["toast.css"],
      "js": ["common-injector.js", "hashnode-injector.js"]
    },
    {
      "matches": ["*://medium.com/*", "*://*.medium.com/*"],
      "css": ["toast.css"],
      "js": ["common-injector.js", "medium-injector.js"]
    },
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Cerebellum"
  }
}
